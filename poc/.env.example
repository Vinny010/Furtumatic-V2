# Copy to .env and fill in. NEVER commit the real .env.
# Free eBay dev credentials: https://developer.ebay.com -> create app -> PRODUCTION keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Economics (override the defaults in config.py) ---
# Only show products where net profit is at least this % of the buy price.
MIN_MARGIN_PCT=100
MIN_NET_PROFIT=2.0

# eBay UK selling costs — CHECK against your own shop tier & category.
EBAY_FV_FEE_PCT=0.128
EBAY_FV_FEE_FIXED=0.30
POSTAGE_COST=3.30
PACKAGING_COST=0.30
HANDLING_COST=0.0

# --- Scraper politeness / quota ---
REQUEST_DELAY_S=1.5
MAX_EBAY_LOOKUPS=50
EBAY_MARKETPLACE_ID=EBAY_GB
